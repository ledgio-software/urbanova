# ─── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres — provided automatically when you link a Vercel Postgres DB
# For local dev: use your own Postgres instance
POSTGRES_URL=
POSTGRES_PRISMA_URL=          # used by Prisma (with ?pgbouncer=true for pooling)
POSTGRES_URL_NON_POOLING=     # used by prisma migrate deploy (direct connection)

# Prisma uses these two variables — map them from the above
DATABASE_URL=                 # = POSTGRES_PRISMA_URL (pooled)
DIRECT_URL=                   # = POSTGRES_URL_NON_POOLING (direct, for migrations)

# ─── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=          # sk_test_... (test) or sk_live_... (production)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=   # pk_test_... or pk_live_...

# ─── Admin Auth (Auth.js / NextAuth) ──────────────────────────────────────────
AUTH_SECRET=                  # generate: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000

ADMIN_USERNAME=admin           # admin login username
ADMIN_PASSWORD=               # admin login password (use a strong password)

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=               # resend.com → API Keys

# ─── Vercel Blob (product image uploads) ──────────────────────────────────────
BLOB_READ_WRITE_TOKEN=        # Vercel project → Storage → Blob → token

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Policies & business details (docs/URBANOVA_REFERENCE.md Part H) ───────────
# Shown on the public policy pages. Leave blank until confirmed — blank values are
# omitted from the pages (never shown as placeholders). Numeric policy parameters
# (return windows, refund times, etc.) live in lib/site-config.ts.
BUSINESS_NAME=                # registered business name
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_TIN=
BUSINESS_ADDRESS=
BUSINESS_DIGITAL_ADDRESS=     # Ghana Post digital address
CONTACT_PHONE=                # phone / WhatsApp: policy pages + Contact "Message Us"; defaults to +233 55 778 6833
CONTACT_EMAIL=                # Contact page + policies; defaults to urbanovaclothing6@gmail.com
PARTNER_EMAIL=                # "Become a Partner" button; defaults to urbanovaclothing6@gmail.com
MOVEMENT_ENTITY_NAME=         # not-for-profit arm, once registered
DPC_REGISTRATION_NUMBER=      # Data Protection Commission registration number
SAFEGUARDING_LEAD_NAME=       # must be set before any under-18 joins
SAFEGUARDING_LEAD_CONTACT=
POLICY_EFFECTIVE_DATE=        # e.g. "1 November 2026" — shown as "Effective: …"

# ─── Ad pixels (retargeting) ───────────────────────────────────────────────────
# Loaded only after a visitor taps "Accept" in the cookie banner. The banner and the
# footer "Cookie settings" link appear only when at least one ID is set.
META_PIXEL_ID=                # Meta Events Manager → Data sources → Pixel ID (digits)
TIKTOK_PIXEL_ID=              # TikTok Ads Manager → Assets → Events → Web pixel ID
