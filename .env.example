# ─── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres — provided automatically when you link a Vercel Postgres DB
# For local dev: use your own Postgres instance
POSTGRES_URL=
POSTGRES_PRISMA_URL=          # used by Prisma (with ?pgbouncer=true for pooling)
POSTGRES_URL_NON_POOLING=     # used by prisma migrate deploy (direct connection)

# Prisma uses these two variables — map them from the above
DATABASE_URL=                 # = POSTGRES_PRISMA_URL (pooled)
DIRECT_URL=                   # = POSTGRES_URL_NON_POOLING (direct, for migrations)

# ─── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=          # sk_test_... (test) or sk_live_... (production)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=   # pk_test_... or pk_live_...

# ─── Admin Auth (Auth.js / NextAuth) ──────────────────────────────────────────
NEXTAUTH_SECRET=              # generate: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=          # bcrypt hash of the admin password

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=               # resend.com → API Keys

# ─── Vercel Blob (product image uploads) ──────────────────────────────────────
BLOB_READ_WRITE_TOKEN=        # Vercel project → Storage → Blob → token

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
