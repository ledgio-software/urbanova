generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Categories ───────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]

  @@map("categories")
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  categoryId  String
  description String
  basePrice   Int              // stored in pesewas (smallest GHS unit)
  featured    Boolean          @default(false)
  tags        String[]
  createdAt   DateTime         @default(now())

  // null = sold by URBANOVA itself; set = listed by a marketplace partner (Reference Part I)
  partnerId   String?

  category    Category         @relation(fields: [categoryId], references: [id])
  partner     Partner?         @relation(fields: [partnerId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([slug])
  @@index([featured])
  @@index([partnerId])
  @@map("products")
}

// ─── Product Variants (SKUs) ──────────────────────────────────────────────────
// SKU format: URB-[CATEGORY]-[STYLE]-[COLOR]-[SIZE]
// e.g. URB-TS-SKYLINE-BLK-M

model ProductVariant {
  id            String         @id @default(cuid())
  productId     String
  sku           String         @unique
  size          String
  color         String
  stockQuantity Int            @default(0)
  priceOverride Int?           // nullable — falls back to product.basePrice

  product       Product        @relation(fields: [productId], references: [id])
  images        ProductImage[]
  orderItems    OrderItem[]

  @@index([sku])
  @@map("product_variants")
}

// ─── Product Images ───────────────────────────────────────────────────────────

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?         // nullable — color-specific images link to a variant
  url       String
  sortOrder Int             @default(0)

  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("product_images")
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  createdAt DateTime @default(now())

  orders    Order[]

  @@map("customers")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

enum OrderStatus {
  pending_payment
  paid
  packed
  shipped
  delivered
  cancelled
  returned
}

model Order {
  id               String      @id @default(cuid())
  customerId       String?     // nullable — guest checkout
  status           OrderStatus @default(pending_payment)
  subtotal         Int         // pesewas
  deliveryFee      Int         // pesewas
  total            Int         // pesewas
  deliveryZone     String
  deliveryAddress  String
  paymentMethod    String
  paymentReference String?     // Paystack transaction reference — set after webhook confirms payment

  createdAt        DateTime    @default(now())

  customer         Customer?   @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  delivery         DeliveryJob?

  @@index([status])
  @@map("orders")
}

// ─── Order Items ──────────────────────────────────────────────────────────────

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Int            // pesewas — snapshot of price at time of purchase

  order     Order          @relation(fields: [orderId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ─── Delivery Zones ───────────────────────────────────────────────────────────
// Editable from admin — fees and zones are still "to be confirmed" by founder.
// See docs/URBANOVA_REFERENCE.md Appendix.

model DeliveryZone {
  id            String @id @default(cuid())
  name          String
  estimatedDays String // e.g. "1–2 business days"
  fee           Int    // pesewas — editable from admin panel

  @@map("delivery_zones")
}

// ─── Marketplace partners (Nova Market) ───────────────────────────────────────
// Founder-approved Nov 2026 — see docs/URBANOVA_REFERENCE.md Part I.
// Partners get a page on the site and a dashboard; URBANOVA keeps a commission.

enum PartnerStatus {
  pending   // created by admin, not yet live
  active    // public page + products visible
  suspended // hidden; partner logins blocked
}

model Partner {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  tagline             String?
  description         String?
  logoUrl             String?
  bannerUrl           String?
  contactEmail        String
  contactPhone        String        // WhatsApp-reachable number
  location            String?
  status              PartnerStatus @default(pending)
  commissionBps       Int?          // URBANOVA's cut in basis points (1000 = 10%); set by admin before activation
  payoutMethod        String?       // e.g. mtn_momo, telecel_cash, at_money, bank
  payoutAccountName   String?
  payoutAccountNumber String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  users               PartnerUser[]
  products            Product[]

  @@index([status])
  @@map("partners")
}

model PartnerUser {
  id                 String    @id @default(cuid())
  partnerId          String
  name               String
  email              String    @unique // stored lowercase
  passwordHash       String    // scrypt — see lib/password.ts
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  partner            Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_users")
}

// ─── URBANOVA Delivery ────────────────────────────────────────────────────────
// Founder-approved Nov 2026 — see docs/URBANOVA_REFERENCE.md Part J.
// URBANOVA's own riders deliver website orders (later: partner orders and outside bookings).

enum RiderStatus {
  active
  suspended // logins blocked, can't be assigned
}

model Rider {
  id                 String        @id @default(cuid())
  name               String
  phone              String
  email              String        @unique // login, stored lowercase
  passwordHash       String        // scrypt — see lib/password.ts
  mustChangePassword Boolean       @default(true)
  vehicle            String?       // e.g. "Motorbike GR-1234-24"
  status             RiderStatus   @default(active)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())

  jobs               DeliveryJob[]

  @@map("riders")
}

enum DeliveryStatus {
  pending    // created, no rider yet
  assigned   // rider assigned, not collected
  picked_up  // rider has the parcel
  on_the_way // heading to the customer
  delivered  // confirmed with the customer's delivery code
  failed     // couldn't deliver (reason recorded)
  cancelled
}

enum DeliverySource {
  store_order   // URBANOVA website order
  partner_order // marketplace partner order (Part I)
  booking       // outside business parcel booking
}

model DeliveryJob {
  id             String         @id @default(cuid())
  trackingCode   String         @unique // public, used in /track/[code]
  deliveryCode   String         // 4-digit PIN the customer gives the rider; never shown on public/rider views
  codeAttempts   Int            @default(0)
  source         DeliverySource
  orderId        String?        @unique
  riderId        String?
  status         DeliveryStatus @default(pending)

  pickupName     String
  pickupPhone    String
  pickupAddress  String
  dropoffName    String
  dropoffPhone   String
  dropoffAddress String
  notes          String?
  fee            Int            // pesewas charged for the delivery
  failureReason  String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order          Order?         @relation(fields: [orderId], references: [id])
  rider          Rider?         @relation(fields: [riderId], references: [id])
  events         DeliveryEvent[]

  @@index([status])
  @@index([riderId])
  @@map("delivery_jobs")
}

model DeliveryEvent {
  id        String         @id @default(cuid())
  jobId     String
  status    DeliveryStatus
  note      String?
  actor     String         // "admin" | "rider" | "system"
  createdAt DateTime       @default(now())

  job       DeliveryJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("delivery_events")
}
